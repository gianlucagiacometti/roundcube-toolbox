#!/usr/bin/env php
<?php

/**
 * Prepare Toolbox's writable directories for a standard Roundcube installation.
 *
 * Customise uses plugins/toolbox/tmp.
 * Detached attachments are stored in plugins/toolbox/attachments.
 */

$plugin_path = realpath(__DIR__ . '/..');

if ($plugin_path === false) {
    fwrite(STDERR, "ERROR: Cannot locate Toolbox directory. No directories created.\n");
    exit(1);
}

$directories = [
    $plugin_path . '/tmp',
    $plugin_path . '/attachments',
];

foreach ($directories as $directory) {
    if (!is_dir($directory) && !mkdir($directory, 0777)) {
        fwrite(STDERR, "ERROR: Cannot create directory: {$directory}\n");
        exit(1);
    }

    if (!chmod($directory, 0777)) {
        fwrite(STDERR, "ERROR: Cannot set permissions on directory: {$directory}\n");
        exit(1);
    }
}


// END OF FILE
